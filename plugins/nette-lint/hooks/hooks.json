{
	"description": "Validate PHP, Latte templates, NEON files, JSON, and JavaScript/TypeScript",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-php.php\""
					},
					{
						"type": "command",
						"command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-latte.php\""
					},
					{
						"type": "command",
						"command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-neon.php\""
					},
					{
						"type": "command",
						"command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-json.php\""
					},
					{
						"type": "command",
						"command": "php \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-js.php\""
					}
				]
			}
		]
	}
}
